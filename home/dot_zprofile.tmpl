# ~/.zprofile — login shell. Keep heavy PATH/env setup here.

{{ if eq .chezmoi.os "darwin" -}}
# Homebrew (Apple Silicon first, then Intel).
if [ -x /opt/homebrew/bin/brew ]; then
  eval "$(/opt/homebrew/bin/brew shellenv)"
elif [ -x /usr/local/bin/brew ]; then
  eval "$(/usr/local/bin/brew shellenv)"
fi
{{ else -}}
# Linuxbrew.
[ -x /home/linuxbrew/.linuxbrew/bin/brew ] && eval "$(/home/linuxbrew/.linuxbrew/bin/brew shellenv)"
{{ end -}}

# User-local binaries (~/.local/bin). Script-method installers drop CLIs here —
# notably the Proton Pass CLI (pass-cli), which chezmoi pulls secrets through.
# Those installers append their own PATH line to the shell rc, but chezmoi owns
# these files and overwrites that on every apply, so we set the PATH here. Without
# it a fresh shell can't find pass-cli and `proton-pass-doctor` reports it "not
# installed" even though it is. $HOME resolves at runtime — nothing hardcoded.
export PATH="$HOME/.local/bin:$PATH"

# Registry CLIs are mise-owned and do not need this; an ad-hoc `npm i -g` does.
# .chezmoidata/paths.toml explains the pin and is the only place it is written.
export NPM_CONFIG_PREFIX="{{ .npm_global_prefix }}"
# Puts those installs on PATH at all, ahead of ~/Library/pnpm/bin (pnpm's
# installer adds that) so an npm global beats a pnpm one of the same name.
export PATH="$NPM_CONFIG_PREFIX/bin:$PATH"

# Registry CLIs live under mise now, and `mise activate` runs from .zshrc, which
# zsh sources for INTERACTIVE shells only. Without this a `zsh -lc`, a LaunchAgent
# or a cron job would not find eas/vercel/screenpipe at all, and would fall through
# to whatever stray copy is left on PATH. Shims need no activation; activate simply
# wins over them when it does run. Last, so mise beats the npm prefix above: these
# CLIs are mise's to answer for.
export PATH="$HOME/.local/share/mise/shims:$PATH"
